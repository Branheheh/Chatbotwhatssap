# =====================================================
# WhatsApp Cloud API (Meta for Developers)
# =====================================================
# Token de acceso (temporal o permanente) de tu app de WhatsApp Business
WHATSAPP_TOKEN=EAAG...tu_token_de_acceso
# ID del numero de telefono de WhatsApp Business (Meta -> API Setup)
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Token que TU inventas y configuras tambien en el panel de Meta para verificar el webhook
WHATSAPP_VERIFY_TOKEN=conred_verify_token_cambia_esto
# App Secret de tu app de Meta (opcional pero recomendado, para validar la firma X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# Version de la Graph API a usar
WHATSAPP_API_VERSION=v20.0

# =====================================================
# Servidor
# =====================================================
PORT=3000

# =====================================================
# PostgreSQL
# =====================================================
DATABASE_URL=postgresql://conred:conred_password@localhost:5432/conred_bot
# Poner en "true" si tu proveedor de PostgreSQL exige SSL (por ejemplo, algunos hosts en la nube)
PGSSL=false
